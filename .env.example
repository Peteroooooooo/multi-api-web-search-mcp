# ==============================================================================
# Multi API Web Search MCP configuration
# Copy to .env and fill in the two required lines, then run `npm run setup`
# (or double-click doctor.bat) to test your models and fill in the rest.
# The MCP server reads this file on start; values in the MCP client's "env"
# block, if any, take priority over this file.
# ==============================================================================

# Required: OpenAI-compatible endpoint base URL (e.g. https://api.openai.com/v1 or your relay)
MULTI_WEB_SEARCH_BASE_URL=https://api.your-provider.com/v1

# Required: API key for that endpoint
MULTI_WEB_SEARCH_API_KEY=sk-your-api-key-here

# Default search model, or 'hybrid' to ask several models in parallel
MULTI_WEB_SEARCH_MODEL=gpt-4o-mini

# Models used by 'hybrid' (comma-separated)
# Example: MULTI_WEB_SEARCH_HYBRID_MODELS=gpt-4o-mini,gpt-4o
MULTI_WEB_SEARCH_HYBRID_MODELS=

# Search mode per model (comma-separated, exact name or a name fragment such as 'gemini').
# FORCE_TOOL sends the explicit web_search tool; FORCE_NATIVE never sends it.
# Unlisted models use the tool if their name contains grok / gpt / search.
MULTI_WEB_SEARCH_FORCE_TOOL=
MULTI_WEB_SEARCH_FORCE_NATIVE=

# Optional: model to retry with when the default model fails
# MULTI_WEB_SEARCH_FALLBACK_MODEL=gpt-4o-mini

# Optional: max wait in ms for the first word of the answer, per attempt (default 25000).
# Healthy answers start in 3-12 s. A silent request is dropped and sent once more.
# Answers are streamed, so a model that is still writing is never cut by this limit.
MULTI_WEB_SEARCH_TIMEOUT_MS=25000

# Optional: after output starts, cut a stream that sends nothing for this many ms (default 30000)
# MULTI_WEB_SEARCH_IDLE_TIMEOUT_MS=30000

# Optional: reasoning_effort sent with every request: low / medium / high.
# Not sent when unset; `npm run setup` saves low if your models accept it.
# Models that reject it are retried once without it.
# MULTI_WEB_SEARCH_REASONING_EFFORT=low

# Optional: default search focus when the caller does not pick one: broad / precise.
# broad = many distinct items and sources, long answers; best left to the caller per question.
# MULTI_WEB_SEARCH_FOCUS=

# Optional: also expose the tool under the name 'web_search' (1 = yes)
# MULTI_WEB_SEARCH_ALIAS=1
