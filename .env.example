# ==============================================================================
# Multi API Web Search MCP Configuration Template
# Copy this file to .env and fill in your details, or run `doctor.bat` to auto-configure.
# ==============================================================================

# Required: Your OpenAI-compatible API endpoint base URL (e.g. https://api.openai.com/v1 or custom proxy)
MULTI_WEB_SEARCH_BASE_URL=https://api.your-provider.com/v1

# Required: Your API Key
MULTI_WEB_SEARCH_API_KEY=sk-your-api-key-here

# Optional: Default search model (Default: gemini-3.8-flash)
# Recommended candidates:
# - gemini-3.8-flash (Fast & comprehensive knowledge synthesis)
# - grok-chat-fast (Real-time live search with 15+ rich citations)
# - grok-4.20-multi-agent-0309 (Deep research multi-agent reports)
# - gpt-5-6 (Fast 2s factual search via Native Grounding)
# - hybrid (Multi-Engine consensus search merging multiple perspectives)
MULTI_WEB_SEARCH_MODEL=gemini-3.8-flash

# Optional: Models forced to use Native Grounding (pure search without explicit tools, comma-separated)
# Useful for models like gpt-5-5, gpt-5-6 where explicit tool calling easily triggers upstream 504 timeouts.
MULTI_WEB_SEARCH_FORCE_NATIVE=gpt-5-5,gpt-5-6,gemini-3.8-flash

# Optional: Engines for Consensus Hybrid Search (comma-separated, e.g. grok-chat-fast,gpt-5-6)
MULTI_WEB_SEARCH_HYBRID_MODELS=grok-chat-fast,gpt-5-6

# Optional: Request timeout in milliseconds (Default: 90000)
MULTI_WEB_SEARCH_TIMEOUT_MS=90000
