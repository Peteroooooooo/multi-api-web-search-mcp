# ==============================================================================
# Multi API Web Search MCP Configuration Template
# Copy this file to .env and fill in your details, or run `doctor.bat` to auto-configure.
# ==============================================================================

# Required: Your OpenAI-compatible API endpoint base URL (e.g. https://api.openai.com/v1 or custom proxy)
MULTI_WEB_SEARCH_BASE_URL=https://api.your-provider.com/v1

# Required: Your API Key
MULTI_WEB_SEARCH_API_KEY=sk-your-api-key-here

# Optional: Default search model (or 'hybrid' for multi-engine consensus)
# Specify any model supported by your endpoint (e.g. gpt-4o-mini, gpt-4o, etc.)
MULTI_WEB_SEARCH_MODEL=gpt-4o-mini

# Optional: Fallback model if primary model fails
# MULTI_WEB_SEARCH_FALLBACK_MODEL=gpt-4o-mini

# Optional: Models forced to use Native Grounding (pure search without explicit tools, comma-separated)
MULTI_WEB_SEARCH_FORCE_NATIVE=

# Optional: Engines for Consensus Hybrid Search (comma-separated, required if model='hybrid')
# Example: MULTI_WEB_SEARCH_HYBRID_MODELS=gpt-4o-mini,gpt-4o
MULTI_WEB_SEARCH_HYBRID_MODELS=

# Optional: Request timeout in milliseconds (Default: 60000)
MULTI_WEB_SEARCH_TIMEOUT_MS=60000
